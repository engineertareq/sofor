APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# The language visitors see until they pick one (bn or en).
APP_INTERFACE_LOCALE=bn
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sign up links and password resets. "log" writes emails to storage/logs.
# Hostinger: MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Text messages (phone verification and password reset codes) through
# sms.net.bd. SMS_DRIVER=log writes them to storage/logs instead of sending.
SMS_DRIVER=log
SMS_NET_BD_API_KEY=
# An approved sender ID (masking), if you have one. Empty uses the default.
SMS_NET_BD_SENDER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media uploads (profile photos, sponsor logos): "r2" for Cloudflare R2, or
# "local" for storage/app/private. The platform logo and favicon always stay
# local. Move existing files with `php artisan media:move-to-r2`.
MEDIA_STORAGE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket (sponsor logos) and the URL it is served from, e.g. a custom domain.
R2_BUCKET=
R2_PUBLIC_URL=
# Private bucket (profile photos), only ever read through the app.
R2_PRIVATE_BUCKET=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# bKash Checkout (PGW). Leave the credentials empty to hide the bKash payment
# option in the app - everything else keeps working.
# ---------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_API=auto
BKASH_SCRIPT_URL=https://scripts.pay.bka.sh/versions/1.2.0-beta/checkout/bKash-checkout.js
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# Only for legacy (non tokenized) accounts: the Checkout URL from the merchant portal.
BKASH_CHECKOUT_URL=
BKASH_MFS_CHARGE_PERCENT=1.5
BKASH_SANDBOX=true
BKASH_TIMEOUT=30
BKASH_INTENT_TTL=120

# ---------------------------------------------------------------------------
# Search engines. Paste only the content="..." value of the HTML-tag check
# from Google Search Console and Bing Webmaster Tools. Empty = no tag.
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
